# Supabase — required for online multiplayer (lobby + race relay).
# Create a project at https://supabase.com/dashboard, enable Anonymous sign-in,
# and run supabase/schema.sql in the SQL Editor.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — only for local Colyseus dev (pnpm dev:server + colyseusRaceNetwork).
# VITE_COLYSEUS_URL=ws://localhost:2567
